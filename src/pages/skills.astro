---
import Layout from '../layouts/Layout.astro';
import { featuredSkills } from '../data/ecosystem';

const categories = [...new Set(featuredSkills.map(s => s.category))];
---

<Layout title="Skills">
  <h1>🔧 Skills 目录</h1>
  <p class="subtitle">发现和安装 OpenClaw Agent 技能包</p>

  <div class="filters">
    <span class="filter-label">分类：</span>
    <button class="filter-btn active">全部</button>
    {categories.map(cat => <button class="filter-btn">{cat}</button>)}
  </div>

  <div class="skills-grid">
    {featuredSkills.map((skill) => (
      <div class="skill-card">
        <div class="skill-header">
          <h3 class="skill-name">{skill.name}</h3>
          {skill.featured && <span class="featured-badge">🔥 热门</span>}
        </div>
        <p class="skill-desc">{skill.description}</p>
        <div class="skill-meta">
          <span class="skill-author">👤 {skill.author}</span>
          <span class="skill-stars">⭐ {skill.stars}</span>
        </div>
        <div class="skill-category-tag">{skill.category}</div>
        <div class="skill-tags">
          {skill.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
        <a href={skill.url} target="_blank" class="install-btn">
          查看详情 →
        </a>
      </div>
    ))}
  </div>

  <section class="contribute">
    <h2>📤 发布你的 Skill</h2>
    <p>开发了有用的 Skill？分享到 ClawHub 让更多人使用！</p>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p>创建 SKILL.md 文件定义你的技能</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p>使用 <code>clawhub publish</code> 发布</p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p>用户通过 <code>clawhub install</code> 安装</p>
      </div>
    </div>
    <a href="https://docs.openclaw.ai/skills" target="_blank" class="docs-link">
      📚 查看 Skills 开发文档
    </a>
  </section>
</Layout>

<style>
  .subtitle {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .filters {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .filter-label {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .filter-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover, .filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .skill-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .skill-name {
    font-size: 1.2rem;
    color: var(--accent);
  }

  .featured-badge {
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .skill-desc {
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 1rem;
  }

  .skill-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .skill-category-tag {
    display: inline-block;
    background: rgba(99, 102, 241, 0.2);
    color: var(--primary);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .skill-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background: rgba(34, 211, 238, 0.1);
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .install-btn {
    background: var(--primary);
    color: white;
    text-align: center;
    padding: 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }

  .install-btn:hover {
    background: var(--primary-dark);
  }

  .contribute {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
  }

  .contribute h2 {
    margin-bottom: 0.5rem;
  }

  .contribute p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .steps {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .step {
    text-align: center;
  }

  .step-num {
    display: inline-block;
    width: 32px;
    height: 32px;
    line-height: 32px;
    background: var(--primary);
    border-radius: 50%;
    color: white;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .step p {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 180px;
  }

  .step code {
    background: var(--bg);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .docs-link {
    display: inline-block;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--accent);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .docs-link:hover {
    border-color: var(--accent);
  }
</style>
