---
import Layout from '../layouts/Layout.astro';
import { clawPlatforms, totalStats, formatNumber, formatGrowth, getGrowthColor } from '../data/clawStats';

const sortedByDAU = [...clawPlatforms].sort((a, b) => b.stats.dau - a.stats.dau);
const sortedByToken = [...clawPlatforms].sort((a, b) => b.stats.tokenConsumption.daily - a.stats.tokenConsumption.daily);
---

<Layout title="国产 Claw 数据看板">
  <div class="page-header">
    <h1>📊 国产 Claw 数据看板</h1>
    <p class="subtitle">实时监控各大 AI Agent 平台的用户活跃度与 Token 消耗</p>
    <span class="update-time">数据更新于：2026-03-18</span>
  </div>

  <!-- 总览统计 -->
  <section class="overview-section">
    <h2>📈 总览数据</h2>
    <div class="stats-grid">
      <div class="stat-card primary">
        <div class="stat-icon">👥</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalDAU)}</div>
          <div class="stat-label">今日活跃 (DAU)</div>
          <div class="stat-growth" style={`color: ${getGrowthColor(totalStats.avgGrowthDAU)}`}>
            {formatGrowth(totalStats.avgGrowthDAU)} 较昨日
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🌐</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalMAU)}</div>
          <div class="stat-label">月活用户 (MAU)</div>
          <div class="stat-growth" style={`color: ${getGrowthColor(totalStats.avgGrowthMAU)}`}>
            {formatGrowth(totalStats.avgGrowthMAU)} 较上月
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🎯</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalUsers)}</div>
          <div class="stat-label">总用户数</div>
        </div>
      </div>
      <div class="stat-card accent">
        <div class="stat-icon">⚡</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalTokenDaily)}</div>
          <div class="stat-label">今日 Token 消耗</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">📅</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalTokenMonthly)}</div>
          <div class="stat-label">本月 Token 消耗</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 平台排行 -->
  <section class="ranking-section">
    <div class="ranking-tabs">
      <button class="tab-btn active" data-tab="dau">按 DAU 排行</button>
      <button class="tab-btn" data-tab="token">按 Token 消耗排行</button>
    </div>
    
    <div class="ranking-content">
      <div class="ranking-table">
        <div class="table-header">
          <span class="col-rank">排名</span>
          <span class="col-platform">平台</span>
          <span class="col-dau">DAU</span>
          <span class="col-mau">MAU</span>
          <span class="col-token">日 Token 消耗</span>
          <span class="col-growth">增长率</span>
        </div>
        {sortedByDAU.map((platform, index) => (
          <div class="table-row">
            <span class="col-rank">
              {index < 3 ? (
                <span class={`rank-badge rank-${index + 1}`}>{index + 1}</span>
              ) : (
                index + 1
              )}
            </span>
            <span class="col-platform">
              <a href={platform.website} target="_blank" class="platform-link">
                <span class="platform-logo">{platform.logo}</span>
                <span class="platform-info">
                  <span class="platform-name">{platform.name}</span>
                  <span class="platform-desc">{platform.description}</span>
                </span>
              </a>
            </span>
            <span class="col-dau">{formatNumber(platform.stats.dau)}</span>
            <span class="col-mau">{formatNumber(platform.stats.mau)}</span>
            <span class="col-token">{formatNumber(platform.stats.tokenConsumption.daily)}</span>
            <span class="col-growth">
              <span class="growth-badge" style={`background: ${getGrowthColor(platform.stats.growth.dauGrowth)}20; color: ${getGrowthColor(platform.stats.growth.dauGrowth)}`}>
                {formatGrowth(platform.stats.growth.dauGrowth)}
              </span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 平台详情卡片 -->
  <section class="platforms-section">
    <h2>🔍 平台详情</h2>
    <div class="platforms-grid">
      {clawPlatforms.map((platform) => (
        <div class="platform-card">
          <div class="platform-header">
            <span class="platform-logo-large">{platform.logo}</span>
            <div class="platform-title">
              <h3>{platform.name}</h3>
              <span class="platform-category">{platform.category}</span>
            </div>
          </div>
          <p class="platform-desc">{platform.description}</p>
          
          <div class="platform-metrics">
            <div class="metric">
              <span class="metric-label">DAU</span>
              <span class="metric-value">{formatNumber(platform.stats.dau)}</span>
            </div>
            <div class="metric">
              <span class="metric-label">MAU</span>
              <span class="metric-value">{formatNumber(platform.stats.mau)}</span>
            </div>
            <div class="metric">
              <span class="metric-label">Token/日</span>
              <span class="metric-value">{formatNumber(platform.stats.tokenConsumption.daily)}</span>
            </div>
          </div>

          <div class="platform-trend">
            <span class="trend-label">30日趋势</span>
            <div class="sparkline">
              {platform.trend.dau.map((value, i) => {
                const max = Math.max(...platform.trend.dau);
                const min = Math.min(...platform.trend.dau);
                const height = ((value - min) / (max - min)) * 30 + 10;
                return (
                  <div 
                    class="spark-bar" 
                    style={`height: ${height}px; background: ${getGrowthColor(platform.stats.growth.dauGrowth)}`}
                    title={`${platform.trend.dates[i]}: ${formatNumber(value)} DAU`}
                  />
                );
              })}
            </div>
          </div>

          <div class="platform-links">
            <a href={platform.website} target="_blank" class="link-btn">官网 →</a>
            {platform.github && <a href={platform.github} target="_blank" class="link-btn secondary">GitHub →</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 数据说明 -->
  <section class="info-section">
    <h2>ℹ️ 数据说明</h2>
    <div class="info-grid">
      <div class="info-card">
        <h3>📊 数据来源</h3>
        <ul>
          <li>各平台官方公开数据</li>
          <li>GitHub 活跃指标</li>
          <li>社区调研统计</li>
          <li>API 调用量估算</li>
        </ul>
      </div>
      <div class="info-card">
        <h3>🔄 更新频率</h3>
        <ul>
          <li>DAU/MAU: 每日更新</li>
          <li>Token 消耗: 实时估算</li>
          <li>趋势数据: 30天滚动</li>
          <li>平台列表: 每周审核</li>
        </ul>
      </div>
      <div class="info-card">
        <h3>📈 统计口径</h3>
        <ul>
          <li>DAU: 日活跃用户（去重）</li>
          <li>MAU: 月活跃用户（去重）</li>
          <li>Token: 输入+输出 tokens</li>
          <li>增长率: 7日/30日环比</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0;
    margin-bottom: 2rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0.5rem 0;
  }

  .update-time {
    display: inline-block;
    background: rgba(34, 211, 238, 0.1);
    color: var(--accent);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  .overview-section {
    margin-bottom: 3rem;
  }

  .overview-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .stat-card.primary {
    border-color: var(--primary);
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(99, 102, 241, 0.05));
  }

  .stat-card.accent {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(34, 211, 238, 0.05));
  }

  .stat-icon {
    font-size: 2rem;
    background: var(--bg);
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .stat-info {
    flex: 1;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: bold;
    color: var(--text);
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .stat-growth {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    font-weight: 500;
  }

  .ranking-section {
    margin-bottom: 3rem;
  }

  .ranking-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tab-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .tab-btn:hover, .tab-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  .ranking-table {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .table-header {
    display: grid;
    grid-template-columns: 60px 2fr 1fr 1fr 1fr 100px;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .table-row {
    display: grid;
    grid-template-columns: 60px 2fr 1fr 1fr 1fr 100px;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    align-items: center;
  }

  .table-row:hover {
    background: rgba(99, 102, 241, 0.05);
  }

  .col-rank {
    font-weight: bold;
  }

  .rank-badge {
    display: inline-block;
    width: 28px;
    height: 28px;
    line-height: 28px;
    text-align: center;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .rank-1 {
    background: linear-gradient(135deg, #ffd700, #ffb700);
    color: #000;
  }

  .rank-2 {
    background: linear-gradient(135deg, #c0c0c0, #a0a0a0);
    color: #000;
  }

  .rank-3 {
    background: linear-gradient(135deg, #cd7f32, #b87333);
    color: #fff;
  }

  .platform-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .platform-logo {
    font-size: 1.5rem;
  }

  .platform-info {
    display: flex;
    flex-direction: column;
  }

  .platform-name {
    font-weight: 600;
    color: var(--text);
  }

  .platform-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .growth-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .platforms-section {
    margin-bottom: 3rem;
  }

  .platforms-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.5rem;
  }

  .platform-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .platform-logo-large {
    font-size: 2.5rem;
    background: var(--bg);
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .platform-title h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .platform-category {
    background: rgba(99, 102, 241, 0.2);
    color: var(--primary);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .platform-card > .platform-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .platform-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .metric {
    text-align: center;
  }

  .metric-label {
    display: block;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .metric-value {
    display: block;
    font-weight: 600;
    font-size: 1rem;
  }

  .platform-trend {
    margin-bottom: 1rem;
  }

  .trend-label {
    display: block;
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .sparkline {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 40px;
  }

  .spark-bar {
    flex: 1;
    min-width: 3px;
    border-radius: 2px;
    opacity: 0.8;
  }

  .platform-links {
    display: flex;
    gap: 0.75rem;
  }

  .link-btn {
    flex: 1;
    background: var(--primary);
    color: white;
    text-align: center;
    padding: 0.6rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .link-btn.secondary {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .info-section {
    margin-bottom: 2rem;
  }

  .info-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .info-card h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .info-card ul {
    list-style: none;
  }

  .info-card li {
    padding: 0.5rem 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .info-card li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
