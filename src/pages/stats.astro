---
import Layout from '../layouts/Layout.astro';
import { clawSoftwares, totalStats, formatNumber, formatGrowth, getPlatformIcon, getTypeLabel } from '../data/clawSoftwares';

const sortedByDAU = [...clawSoftwares].sort((a, b) => b.stats.dau - a.stats.dau);
const sortedByToken = [...clawSoftwares].sort((a, b) => b.stats.tokenConsumption.daily - a.stats.tokenConsumption.daily);
const sortedByRating = [...clawSoftwares].sort((a, b) => b.rating.score - a.rating.score);

const getGrowthColor = (growth: number): string => {
  if (growth >= 20) return '#22c55e';
  if (growth >= 10) return '#84cc16';
  if (growth >= 0) return '#eab308';
  return '#ef4444';
};
---

<Layout title="Claw软件数据看板">
  <div class="page-header">
    <h1>📊 Claw软件数据看板</h1>
    <p class="subtitle">实时监控市面上主流Claw软件的用户活跃度与Token消耗</p>
    <span class="update-time">数据更新于：2026-03-18</span>
  </div>

  <!-- 总览统计 -->
  <section class="overview-section">
    <h2>📈 总览数据</h2>
    <div class="stats-grid">
      <div class="stat-card primary">
        <div class="stat-icon">👥</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalDAU)}</div>
          <div class="stat-label">今日活跃 (DAU)</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🌐</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalMAU)}</div>
          <div class="stat-label">月活用户 (MAU)</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🎯</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalUsers)}</div>
          <div class="stat-label">总用户数</div>
        </div>
      </div>
      <div class="stat-card accent">
        <div class="stat-icon">⚡</div>
        <div class="stat-info">
          <div class="stat-value">{formatNumber(totalStats.totalTokenDaily)}</div>
          <div class="stat-label">今日 Token 消耗</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">⭐</div>
        <div class="stat-info">
          <div class="stat-value">{totalStats.avgRating.toFixed(1)}</div>
          <div class="stat-label">平均评分</div>
          <div class="stat-growth" style="color: var(--accent);">
            {formatNumber(totalStats.totalReviewCount)} 条评价
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 软件排行 -->
  <section class="ranking-section">
    <div class="section-header">
      <h2>🏆 Claw软件排行</h2>
      <div class="ranking-tabs">
        <button class="tab-btn active">按DAU排行</button>
        <button class="tab-btn">按评分排行</button>
        <button class="tab-btn">按Token消耗</button>
      </div>
    </div>
    
    <div class="software-table">
      <div class="table-header">
        <span class="col-rank">排名</span>
        <span class="col-software">软件</span>
        <span class="col-company">厂商</span>
        <span class="col-dau">DAU</span>
        <span class="col-mau">MAU</span>
        <span class="col-token">日Token</span>
        <span class="col-rating">评分</span>
        <span class="col-growth">增长率</span>
      </div>
      
      {sortedByDAU.map((software, index) => (
        <div class="table-row">
          <span class="col-rank">
            {index < 3 ? (
              <span class={`rank-badge rank-${index + 1}`}>{index + 1}</span>
            ) : (
              index + 1
            )}
          </span>
          
          <span class="col-software">
            <a href={software.website} target="_blank" class="software-link">
              <span class="software-logo">{software.logo}</span>
              <span class="software-info">
                <span class="software-name">{software.name}</span>
                <span class="software-type">{getTypeLabel(software.type)}</span>
                <div class="software-platforms">
                  {software.platforms.map(p => <span class="platform-icon" title={p}>{getPlatformIcon(p)}</span>)}
                </div>
              </span>
            </a>
          </span>
          
          <span class="col-company">{software.company}</span>
          <span class="col-dau">{formatNumber(software.stats.dau)}</span>
          <span class="col-mau">{formatNumber(software.stats.mau)}</span>
          <span class="col-token">{formatNumber(software.stats.tokenConsumption.daily)}</span>
          <span class="col-rating">
            <span class="rating-stars">{'⭐'.repeat(Math.floor(software.rating.score))}</span>
            <span class="rating-score">{software.rating.score}</span>
          </span>
          <span class="col-growth">
            <span class="growth-badge" style={`background: ${getGrowthColor(software.stats.growth.dauGrowth)}20; color: ${getGrowthColor(software.stats.growth.dauGrowth)}`}>
              {formatGrowth(software.stats.growth.dauGrowth)}
            </span>
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- 软件详情卡片 -->
  <section class="platforms-section">
    <h2>🔍 软件详情</h2>
    <div class="platforms-grid">
      {clawSoftwares.map((software) => (
        <div class="platform-card">
          <div class="platform-header">
            <span class="platform-logo-large">{software.logo}</span>
            <div class="platform-title">
              <h3>{software.name}</h3>
              <span class="platform-company">{software.company}</span>
              <span class="platform-type">{getTypeLabel(software.type)}</span>
            </div>
          </div>
          <p class="platform-desc">{software.description}</p>
          
          <div class="platform-tags">
            {software.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
          
          <div class="platform-metrics">
            <div class="metric">
              <span class="metric-label">DAU</span>
              <span class="metric-value">{formatNumber(software.stats.dau)}</span>
            </div>
            <div class="metric">
              <span class="metric-label">MAU</span>
              <span class="metric-value">{formatNumber(software.stats.mau)}</span>
            </div>
            <div class="metric">
              <span class="metric-label">评分</span>
              <span class="metric-value">{software.rating.score} ⭐</span>
            </div>
          </div>

          <div class="platform-pricing">
            <span class="pricing-label">定价：</span>
            <span class="pricing-value">{software.pricing.startingPrice}</span>
          </div>

          <div class="platform-links">
            <a href={software.website} target="_blank" class="link-btn">官网 →</a>
            {software.downloadUrl && <a href={software.downloadUrl} target="_blank" class="link-btn secondary">下载 →</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 数据说明 -->
  <section class="info-section">
    <h2>ℹ️ 数据说明</h2>
    <div class="info-grid">
      <div class="info-card">
        <h3>📊 数据来源</h3>
        <ul>
          <li>各软件官方公开数据</li>
          <li>应用商店下载量统计</li>
          <li>用户调研与估算</li>
          <li>社区活跃度监测</li>
        </ul>
      </div>
      <div class="info-card">
        <h3>🔄 更新频率</h3>
        <ul>
          <li>DAU/MAU: 每日更新</li>
          <li>Token消耗: 实时估算</li>
          <li>评分数据: 每周统计</li>
          <li>软件列表: 每月审核</li>
        </ul>
      </div>
      <div class="info-card">
        <h3>📈 统计口径</h3>
        <ul>
          <li>DAU: 日活跃用户（去重）</li>
          <li>MAU: 月活跃用户（去重）</li>
          <li>Token: 输入+输出 tokens</li>
          <li>评分: 1-5分加权平均</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0;
    margin-bottom: 2rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0.5rem 0;
  }

  .update-time {
    display: inline-block;
    background: rgba(34, 211, 238, 0.1);
    color: var(--accent);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  .overview-section {
    margin-bottom: 3rem;
  }

  .overview-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .stat-card.primary {
    border-color: var(--primary);
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(99, 102, 241, 0.05));
  }

  .stat-card.accent {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(34, 211, 238, 0.05));
  }

  .stat-icon {
    font-size: 2rem;
    background: var(--bg);
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .stat-info {
    flex: 1;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: bold;
    color: var(--text);
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .stat-growth {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    font-weight: 500;
  }

  .ranking-section {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
  }

  .ranking-tabs {
    display: flex;
    gap: 0.5rem;
  }

  .tab-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.85rem;
  }

  .tab-btn:hover, .tab-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  .software-table {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .table-header {
    display: grid;
    grid-template-columns: 60px 2fr 120px 100px 100px 100px 100px 80px;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .table-row {
    display: grid;
    grid-template-columns: 60px 2fr 120px 100px 100px 100px 100px 80px;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    align-items: center;
  }

  .table-row:hover {
    background: rgba(99, 102, 241, 0.05);
  }

  .rank-badge {
    display: inline-block;
    width: 28px;
    height: 28px;
    line-height: 28px;
    text-align: center;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .rank-1 {
    background: linear-gradient(135deg, #ffd700, #ffb700);
    color: #000;
  }

  .rank-2 {
    background: linear-gradient(135deg, #c0c0c0, #a0a0a0);
    color: #000;
  }

  .rank-3 {
    background: linear-gradient(135deg, #cd7f32, #b87333);
    color: #fff;
  }

  .software-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .software-logo {
    font-size: 1.5rem;
  }

  .software-info {
    display: flex;
    flex-direction: column;
  }

  .software-name {
    font-weight: 600;
  }

  .software-type {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .software-platforms {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .platform-icon {
    font-size: 0.9rem;
  }

  .rating-stars {
    color: #fbbf24;
    font-size: 0.8rem;
  }

  .rating-score {
    margin-left: 0.5rem;
    font-weight: 600;
  }

  .growth-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .platforms-section {
    margin-bottom: 3rem;
  }

  .platforms-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .platform-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .platform-logo-large {
    font-size: 2.5rem;
    background: var(--bg);
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .platform-title h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .platform-company {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .platform-type {
    display: inline-block;
    background: rgba(99, 102, 241, 0.2);
    color: var(--primary);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }

  .platform-card > .platform-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .platform-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background: rgba(34, 211, 238, 0.1);
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .platform-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .metric {
    text-align: center;
  }

  .metric-label {
    display: block;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .metric-value {
    display: block;
    font-weight: 600;
    font-size: 1rem;
  }

  .platform-pricing {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .pricing-label {
    color: var(--text-muted);
  }

  .pricing-value {
    color: var(--accent);
    font-weight: 600;
  }

  .platform-links {
    display: flex;
    gap: 0.75rem;
  }

  .link-btn {
    flex: 1;
    background: var(--primary);
    color: white;
    text-align: center;
    padding: 0.6rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .link-btn.secondary {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .info-section {
    margin-bottom: 2rem;
  }

  .info-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .info-card h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .info-card ul {
    list-style: none;
  }

  .info-card li {
    padding: 0.5rem 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    position: relative;
    padding-left: 1.25rem;
  }

  .info-card li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
